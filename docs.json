{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Cevexa",
  "colors": {
    "primary": "#BAE6FD",
    "light": "#BAE6FD",
    "dark": "#BAE6FD"
  },
  "icons": {
    "library": "fontawesome"
  },
  "favicon": {
    "light": "/favicon.png",
    "dark": "/favicon.png"
  },
  "navigation": {
    "languages": [
      {
        "$ref": "./en.json"
      },
      {
        "$ref": "./ru.json"
      }
    ]
  },
  "logo": {
    "light": "/icons/Cevexa.png",
    "dark": "/icons/Cevexa.png",
    "href": "https://cevexa.xyz"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "background": {
    "color": {
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "dark"
  }
}
